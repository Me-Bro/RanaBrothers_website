{
  "name": "ranabrothers-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "cross-env NEXT_OUTPUT_EXPORT=1 next build",
    "postbuild": "node scripts/brand-guard.mjs files out",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/guard/brand-guard.test.mjs tests/guard/brand-guard.git.test.mjs tests/guard/setup-hooks.test.mjs",
    "guard": "node scripts/brand-guard.mjs files",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "volta": {
    "node": "24.16.0"
  }
}
